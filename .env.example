APP_NAME="Oweru Tech Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Allow fallback to SQLite if MySQL is unavailable
DB_FALLBACK_TO_SQLITE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oweru_tech_solutions
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative (uncomment to use):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SCANNER_SERVICE_URL=http://localhost:5000
SCANNER_API_KEY=

# PesaPal Payment Gateway (sandbox: https://cybqa.pesapal.com/pesapalv3)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_URL=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@oweru.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# --- Invoicing (50% deposit default) ---
OWERU_DEPOSIT_PERCENT=50
OWERU_DEPOSIT_DUE_DAYS=7
OWERU_REMINDER_INTERVAL_DAYS=3
OWERU_MAX_REMINDERS=4

# --- Auto-scraper (24/7 queue) ---
OWERU_SCRAPER_REFRESH_DAYS=7
OWERU_SCRAPER_BATCH_SIZE=10
OWERU_SCRAPER_RETRY_HOURS=6
# Directory harvesting: auto-queue business links found on directory pages
OWERU_SCRAPER_DISCOVERY=true
OWERU_SCRAPER_DISCOVERY_LIMIT=20

# --- Scraper watchdog (change detection + staff alerts) ---
OWERU_SCRAPER_WATCHDOG=true
OWERU_WATCHDOG_RATING_DROP=0.5
OWERU_WATCHDOG_BAD_REVIEW=3
OWERU_WATCHDOG_COOLDOWN_HOURS=24

# --- Auto health-scan of newly scraped businesses ---
OWERU_AUTO_SCAN=true
OWERU_AUTO_SCAN_MAX_PER_RUN=5

# --- Website discovery (OSM/Overpass -> auto-scraper queue) ---
OWERU_DISCOVERY_PYTHON="C:\python312\python.exe"
OWERU_DISCOVERY_SCRIPT=scanner/osm_discovery.py
OWERU_DISCOVERY_TIMEOUT=150
OWERU_DISCOVERY_DEFAULT_LIMIT=300
OWERU_DISCOVERY_MAX_LIMIT=1000
