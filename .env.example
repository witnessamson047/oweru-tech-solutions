APP_NAME="Oweru Tech Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Allow fallback to SQLite if MySQL is unavailable
DB_FALLBACK_TO_SQLITE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oweru_tech_solutions
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative (uncomment to use):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SCANNER_SERVICE_URL=http://localhost:5000
SCANNER_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@oweru.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
