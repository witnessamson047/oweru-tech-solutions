# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Dependencies (reinstalled with composer install / npm install)
/vendor
/node_modules

# Local data & caches
/database/database.sqlite
/database/database.sqlite-journal
/database/database.sqlite.bak*
*.bak
*.bak-*
/.phpunit.result.cache

# Laravel runtime files
/storage/*.key
/storage/app/reports/*.pdf
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*.log
/storage/*.log
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# Build output — COMMITTED: Vercel serves these as static files and its PHP
# runtime cannot run `npm run build`. Rebuild with `npm run build` and commit
# whenever CSS/JS change.
!/public/build

# Vite dev-server marker — NEVER commit (breaks asset URLs in production)
/public/hot

# OS / editor junk
.DS_Store
Thumbs.db
.idea
.vscode
*.swp

# Python scanner
__pycache__/
*.pyc
scanner/excluded_sites.txt

# Scanner engine runtime logs & flags (project root)
/scanner-service.log
/scanner.log
/scanner-stop.flag
