# Copy to .env ON THE VPS and fill the blanks (never committed — .gitignore
# already excludes .env). Generate APP_KEY locally: php artisan key:generate --show

APP_NAME="Oweru Tech Solutions"
APP_ENV=production
APP_KEY=base64:PASTE_GENERATED_KEY
APP_DEBUG=false
APP_URL=http://YOUR-VPS-IP

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database (docker-compose 'db' service) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=oweru_tech_solutions
DB_USERNAME=oweru
DB_PASSWORD=CHANGE_ME_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_even_stronger
DB_FALLBACK_TO_SQLITE=false

# ── Sessions/cache/queue (server version: real drivers, no /tmp tricks) ─
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (Brevo/Mailgun/etc SMTP) ────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@oweru.co.tz
MAIL_FROM_NAME="${APP_NAME}"

# ── Scanner engine (compose wires http://engine:5000 automatically) ─────
SCANNER_SERVICE_URL=http://engine:5000
SCANNER_API_KEY=CHANGE_ME_long_random_string

# ── PesaPal ──────────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_URL=http://YOUR-VPS-IP/payment/ipn

# ── Oweru business settings ──────────────────────────────────────────────
OWERU_DEPOSIT_PERCENT=50
OWERU_SCRAPER_REFRESH_DAYS=7
OWERU_AUTO_SCAN=true
OWERU_SCRAPER_WATCHDOG=true
